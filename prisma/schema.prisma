generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Client {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  phone         String?
  email         String?
  address       String?
  notes         String?
  abbyReference String?  @unique
  isPersonal    Boolean  @default(false) // véhicule perso (le sien / celui de sa femme) — pas un vrai client, exclu de la liste clients
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles Vehicle[]

  @@index([lastName, firstName])
}

model Vehicle {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  plate            String?
  make             String?
  model            String?
  year             Int?
  mileage          Int?
  mileageUpdatedAt DateTime?
  notes            String?
  tier             String? // gabarit ("citadine" | "standard" | "suv") — même système que le site public (data/vehicleTiers.ts), pour un prix cohérent entre réservation en ligne et intervention en direct

  sold   Boolean   @default(false)
  soldAt DateTime?

  previousOwnerName String? // ancien propriétaire connu, affiché en petit (non modifiable) après un changement de propriétaire

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interventions      Intervention[]
  plannedRepairs     PlannedRepair[]
  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]

  @@index([clientId])
}

model FuelLog {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  date     DateTime
  price    Decimal @db.Decimal(10, 2) // prix payé au total
  quantity Decimal @db.Decimal(6, 2) // litres
  mileage  Int? // kilométrage au moment du plein

  trackedByBank Boolean @default(false) // déjà visible dans le relevé bancaire synchronisé de CAMfinance (carte) — exclu de la synchro carburant pour éviter un doublon

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model Intervention {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  date        DateTime
  endDate     DateTime? // si l'intervention s'étale sur plusieurs jours
  description String
  normalPrice Decimal? @db.Decimal(10, 2) // prix normal / de référence, avant remise
  price       Decimal? @db.Decimal(10, 2) // prix final facturé au client (ou main d'œuvre estimée si status = reserved)

  bookedOnline     Boolean   @default(false) // réservée via le site public
  calcomBookingUid String?   @unique // identifiant unique de la réservation Cal.com, pour éviter les doublons si le webhook est renvoyé
  depositAmount    Decimal?  @db.Decimal(10, 2) // acompte versé
  depositDate      DateTime? // date de versement de l'acompte
  deliveryPrice    Decimal?  @db.Decimal(10, 2) // frais de livraison des pièces
  dossierFee       Decimal?  @db.Decimal(10, 2) // frais de dossier (montant total × taux URSSAF), figé au moment de la réservation
  distanceKm       Decimal?  @db.Decimal(6, 2) // distance domicile client <-> Salon-de-Provence, calculée à la réservation en ligne
  travelFee        Decimal?  @db.Decimal(10, 2) // frais de déplacement (distanceKm × tarif au km), figé au moment de la réservation
  photos      String[] @default([]) // photos de pièces endommagées / notes manuscrites
  photosBefore String[] @default([]) // état du véhicule avant intervention
  photosAfter  String[] @default([]) // état du véhicule après intervention
  notes       String? // points clés / outils spéciaux à prévoir la prochaine fois
  toolLink    String? // lien pour acheter l'outil spécial mentionné dans les notes, si pas encore en sa possession
  vehicleCondition String? // annexe : état constaté (ex: plaquettes ~50%, pneu AV usé)

  mileage    Int? // kilométrage au moment de l'intervention
  hoursSpent Decimal? @db.Decimal(5, 2) // temps RÉELLEMENT travaillé (accumulé par le chrono, ou saisi à la main pour une entrée déjà terminée) — jamais une estimation, pour ne pas fausser le prix facturé au client
  estimatedHours Decimal? @db.Decimal(5, 2) // durée estimée à la réservation, purement indicative — distinct de hoursSpent pour que démarrer le chrono reparte de zéro plutôt que de s'additionner à une estimation

  status          String    @default("done") // draft (en cours sur place) | done (terminée) | reserved (réservation prévue, pas encore commencée)
  reviewReminderSent Boolean @default(false) // relance avis Google déjà envoyée pour cette intervention
  chronoStartedAt DateTime? // si non nul, le chrono tourne actuellement pour cette intervention
  completedAt     DateTime? // date/heure de passage à "done" — point de départ du délai de réouverture (voir REOPEN_WINDOW_DAYS côté service)
  invoicedAt      DateTime? // coché manuellement une fois la facture faite (facturation par lot, différée) — null tant que non fait, alimente la liste "Factures à faire" de l'accueil
  freeReason      String? // justificatif quand l'intervention est offerte/à prix réduit volontairement (échange de bon procédé, petit cadeau...) — distingue une gratuité assumée d'un prix simplement oublié à la saisie

  abbyInvoiceNumber String? @unique

  maintenanceTypeId  String? // type d'entretien principal (rétrocompatibilité / affichage)
  maintenanceType    MaintenanceType? @relation(fields: [maintenanceTypeId], references: [id])
  maintenanceTypeIds String[]         @default([]) // tous les types d'entretien couverts (intervention "combo" : plusieurs types faits en une visite)

  partsUsed PartUsed[]
  payments  Payment[]

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model Payment {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)
  method String? // "cash" | "card" | "transfer" | "check" — moyen de paiement reçu
  date   DateTime @default(now()) // date à laquelle le paiement a été reçu (utilisé pour la synchro espèces vers Finance Copilot)
  note   String? // ex: "Acompte avant intervention"

  // Paiements "card" (Stripe / terminal carte) uniquement : l'argent met ~10 jours à
  // arriver réellement en banque, donc il n'est affiché comme reçu dans l'agenda finance
  // qu'une fois ce champ renseigné (bouton "Confirmer reçu"), plutôt que le jour même.
  receivedConfirmedAt DateTime?

  createdAt DateTime @default(now())

  @@index([interventionId])
}

model PartUsed {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  designation String // ex: "Huile moteur 5w30", "Filtre à huile"
  reference   String? // référence pièce/produit
  quantity    String? // ex: "4L", "1", "2 unités"
  link        String? // lien produit exact (ex: page Autodoc de la pièce achetée)

  price          Decimal? @db.Decimal(10, 2)
  boughtByClient Boolean  @default(false) // pièce achetée par le client lui-même (vs. par CAM)

  stockPartId  String? // si renseigné, décompte automatiquement le stock lié
  stockPart    StockPart? @relation(fields: [stockPartId], references: [id], onDelete: SetNull)
  quantityUsed Int? // quantité décomptée du stock (entier, indépendant du texte libre "quantity")

  createdAt DateTime @default(now())

  @@index([interventionId])
  @@index([stockPartId])
}

model PlannedRepair {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  description String
  targetDate  DateTime?
  status      String   @default("pending") // pending | done | cancelled
  priority    String   @default("normal") // normal | urgent

  partsNote      String? // pièces / huile prévues pour ce devis
  estimatedPrice Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
}

model MaintenanceType {
  id                    String  @id @default(cuid())
  key                   String  @unique
  label                 String
  defaultIntervalMonths Int?
  defaultIntervalKm     Int?
  isActive              Boolean @default(true)
  sortOrder             Int     @default(0)

  interventions Intervention[]
  records       MaintenanceRecord[]
}

model ShopSettings {
  id         String   @id @default(cuid())
  hourlyRate      Decimal  @default(60) @db.Decimal(6, 2)
  urssafRate      Decimal  @default(21.2) @db.Decimal(5, 2) // taux de cotisation URSSAF, pour calculer le frais de dossier des réservations
  travelRatePerKm Decimal  @default(0.35) @db.Decimal(5, 2) // tarif au km facturé pour le déplacement (aller simple depuis Salon-de-Provence)
  loyaltyThreshold Decimal @default(1000) @db.Decimal(10, 2) // montant total dépensé par un client à partir duquel proposer un geste fidélité
  updatedAt       DateTime @updatedAt
}

model StockPart {
  id           String  @id @default(cuid())
  name         String
  reference    String?
  category     String?
  quantity     Int     @default(1)
  location     String? // emplacement dans le garage (ex: "Étagère A, bac 3")
  condition    String? // Neuf | Bon état | Usé | Hors service
  notes        String?
  vehicleMake  String?
  vehicleModel String?
  vehicleYears String?
  aiSummary    String? // résumé de l'identification IA (Gemini), modifiable

  photos    StockPhoto[]
  partsUsed PartUsed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockPhoto {
  id          String    @id @default(cuid())
  stockPartId String
  stockPart   StockPart @relation(fields: [stockPartId], references: [id], onDelete: Cascade)

  url String

  createdAt DateTime @default(now())

  @@index([stockPartId])
}

model MaintenanceRecord {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  maintenanceTypeId String
  maintenanceType   MaintenanceType @relation(fields: [maintenanceTypeId], references: [id])

  lastDoneDate           DateTime?
  lastDoneMileage        Int?
  intervalMonthsOverride Int?
  intervalKmOverride     Int?
  updatedByClient        Boolean @default(false) // true si signalé par le client via la fiche publique (à vérifier)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, maintenanceTypeId])
}

// ---------------------------------------------------------------------------
// Section Finance (ex-CAMfinance / finance-copilot, fusionnée dans CAMadmin)
// ---------------------------------------------------------------------------

model Account {
  id             String   @id @default(cuid())
  name           String
  type           String // "checking" | "savings" | "cash"
  scope          String // "PRO" | "PERSO"
  currentBalance Decimal  @default(0)
  balanceAsOf    DateTime @default(now())
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   Transaction[]
  recurringItems RecurringItem[]
  importBatches  ImportBatch[]
  bankConnection BankConnection?

  @@index([scope])
}

model Category {
  id            String   @id @default(cuid())
  name          String
  scope         String // "PRO" | "PERSO" | "BOTH"
  kind          String // "income" | "expense"
  monthlyBudget Decimal?
  isEssential   Boolean  @default(false)
  color         String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions   Transaction[]
  recurringItems RecurringItem[]

  @@index([scope, kind])
}

model Transaction {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  date        DateTime
  description String
  amount      Decimal // signed: negative = expense, positive = income
  scope       String // "PRO" | "PERSO" — denormalized for fast filtering
  type        String  @default("manual") // "manual" | "imported" | "recurring_generated" | "synced"
  externalId  String? // bank/CRM dedup key, set only for type="synced"

  recurringItemId String?
  recurringItem   RecurringItem? @relation(fields: [recurringItemId], references: [id])

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  isTransfer       Boolean @default(false)
  linkedTransferId String? @unique
  transferReviewed Boolean @default(false) // pour les grosses entrées synchronisées sur un compte bancaire : a-t-on déjà demandé si c'était un virement espèces->banque ? évite de reposer la question à chaque fois

  notes          String?
  attachmentPath String? // URL Vercel Blob du justificatif (photo de ticket)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([accountId, externalId])
  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@index([scope, date])
}

model RecurringItem {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  label            String
  scope            String // "PRO" | "PERSO"
  direction        String // "income" | "expense"
  amount           Decimal
  amountIsEstimate Boolean @default(false)

  frequency    String // "monthly" | "quarterly" | "annual" | "weekly" | "custom_days"
  intervalDays Int?
  dayOfMonth   Int?
  startDate    DateTime
  endDate      DateTime?

  isActive     Boolean @default(true)
  autoGenerate Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([accountId])
  @@index([scope])
}

model ImportBatch {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileName      String
  columnMapping String // JSON-encoded mapping, stored as string
  rowCount      Int
  importedCount Int
  skippedCount  Int
  status        String   @default("completed") // "pending" | "completed" | "failed"
  source        String   @default("csv") // "csv" | "pdf" | "bank_sync" | "crm_cash" | "crm_fuel"
  createdAt     DateTime @default(now())

  transactions Transaction[]

  @@index([accountId])
}

model BankConnection {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  aspspName          String
  aspspCountry       String
  externalAccountUid String    @unique
  sessionId          String
  consentValidUntil  DateTime
  status             String    @default("active") // "active" | "expired" | "revoked" | "error"
  lastSyncedAt       DateTime?
  lastSyncError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Advice {
  id                String    @id @default(cuid())
  ruleKey           String // e.g. "urssaf_shortfall", "category_overspend", "low_balance_forecast"
  severity          String // "info" | "warning" | "critical"
  title             String
  detail            String
  scope             String? // "PRO" | "PERSO" | null (global)
  relatedAccountId  String?
  relatedCategoryId String?
  dismissedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([ruleKey])
  @@index([dismissedAt])
}

model FinanceSettings {
  id                       String    @id @default(cuid())
  urssafRatePct            Decimal   @default(22)
  urssafFrequency          String    @default("quarterly") // "monthly" | "quarterly"
  lowBalanceThresholdPro   Decimal   @default(200)
  lowBalanceThresholdPerso Decimal   @default(100)
  forecastHorizonDays      Int       @default(90)
  savingsGoalAmount        Decimal?
  savingsGoalLabel         String?
  savingsGoalTargetDate    DateTime?
  updatedAt                DateTime  @updatedAt
}

model PlannedPurchase {
  id          String    @id @default(cuid())
  label       String
  link        String?
  price       Decimal?
  plannedDate DateTime?
  scope       String // "PRO" | "PERSO"
  status      String    @default("planned") // "planned" | "bought" | "cancelled"
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

// Verrouillage dynamique de zone géographique par demi-journée : la première réservation
// d'un créneau (matin/apres-midi/journee, ou lundi-1/2/3) sur une date impose sa zone
// aux autres créneaux de cette même date. Écrit de façon synchrone par /api/cal-book,
// indépendamment d'Intervention (qui reste alimentée par le webhook Cal.com, avec délai).
model DayZoneLock {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  slot             String // "matin" | "apres-midi" | "journee" | "lundi-1" | "lundi-2" | "lundi-3"
  zoneKey          String // clé parmi celles de zoneSchedule.ts
  calcomBookingUid String? // traçabilité vers la réservation Cal.com correspondante
  createdAt        DateTime @default(now())

  @@unique([date, slot])
  @@index([date])
}
